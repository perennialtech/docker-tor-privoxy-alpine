# Optional configuration.
# Leave any value blank, or omit the variable, to use the defaults defined in entrypoint.sh.
# This file lists supported overrides and validation rules; it intentionally does not duplicate default values.

# Number of Tor instances to run.
# Must be a decimal integer >= 1 and fit the internal port-block layout.
NUM_TOR_INSTANCES=

# Bandwidth burst limit applied to each Tor client instance.
# Must be a decimal amount optionally followed by Byte(s), KByte(s), MByte(s), GByte(s), or TByte(s).
TOR_BANDWIDTH_BURST=

# Bandwidth rate limit applied to each Tor client instance.
# Must be a decimal amount optionally followed by Byte(s), KByte(s), MByte(s), GByte(s), or TByte(s).
TOR_BANDWIDTH_RATE=

# Every NUM seconds, consider whether to build a new circuit.
# Must be a decimal integer >= 1.
TOR_NEW_CIRCUIT_PERIOD=

# Reuse a circuit first used at most NUM seconds ago.
# Never attach a new stream to a circuit that is too old.
# Must be a decimal integer >= 1.
TOR_MAX_CIRCUIT_DIRTINESS=

# Try for at most NUM seconds when building circuits.
# If the circuit is not open in that time, give up on it.
# Must be a decimal integer >= 1.
TOR_CIRCUIT_BUILD_TIMEOUT=
